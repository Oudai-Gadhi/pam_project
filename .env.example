# ─── SET THIS FIRST ───────────────────────────────────────────────────────────
# Your VM's IP or DNS name — the address you use from your Windows PC browser
# Example: 192.168.1.50   or   pam-server.mycompany.local
PUBLIC_HOST=192.168.1.50

# ─── Keycloak (runs on the VM, NOT in Compose) ───────────────────────────────
# Backend fetches JWKS on the VM itself via localhost
KEYCLOAK_URL=http://localhost:8080
# Browser on Windows reaches Keycloak via the VM's public address
KEYCLOAK_PUBLIC_URL=http://${PUBLIC_HOST}:8080
KEYCLOAK_REALM=pam
KEYCLOAK_CLIENT_ID=pam-app

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://${PUBLIC_HOST}:3000
LOG_LEVEL=INFO

# ─── Frontend (build-time fallback; runtime config.js overrides in Docker) ──
VITE_KEYCLOAK_URL=http://${PUBLIC_HOST}:8080
VITE_KEYCLOAK_REALM=pam
VITE_KEYCLOAK_CLIENT_ID=pam-app
VITE_API_BASE_URL=http://${PUBLIC_HOST}:8000
