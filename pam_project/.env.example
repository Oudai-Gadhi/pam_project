# ─── REQUIRED: your VM IP as seen from Windows ────────────────────────────────
# Edit this file, save as .env, then fill in the secrets below.
PUBLIC_HOST=192.168.1.36

# ─── Keycloak (runs on the VM, NOT in Compose) ───────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://192.168.1.36:8080
KEYCLOAK_REALM=pam
KEYCLOAK_CLIENT_ID=pam-app

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_URL=http://192.168.1.36:3000
LOG_LEVEL=INFO

# ─── Broker request database (separate from Keycloak DB) ─────────────────────
PAM_DB_NAME=pam
PAM_DB_USER=pam
PAM_DB_PASSWORD=change-this-to-a-long-unique-password

# ─── Vault (SSH certificate signing) ─────────────────────────────────────────
# Vault listens on 8210 in this stack (see guac-vault-stack/docker-compose.yaml).
VAULT_ADDR=http://host.docker.internal:8210
# Root token from guac-vault-stack/vault-init.txt (line: "Initial Root Token").
# Do not commit; do not use root in production.
VAULT_TOKEN=hvs.REPLACE-WITH-ROOT-TOKEN-FROM-vault-init.txt
VAULT_SSH_MOUNT=ssh-client-signer
VAULT_SSH_ROLE=dev-role
VAULT_VERIFY_TLS=false

# ─── Guacamole auth-json handoff ─────────────────────────────────────────────
# GUACAMOLE_JSON_SECRET MUST match GUAC_JSON_SECRET in guac-vault-stack/.env
# Generate once with: openssl rand -hex 16
GUACAMOLE_PUBLIC_URL=http://192.168.1.36:8081/guacamole
GUACAMOLE_JSON_SECRET=replace-with-32-random-hex-characters

# ─── Registered PAM targets ──────────────────────────────────────────────────
# Managed automatically by scripts/subscribe-vm.sh — you normally don't edit
# this by hand. Format: {"<ip>": {"host": "<ip>", "port": 22, "users": ["u1"]}}
PAM_TARGETS_JSON={}

# ─── Frontend (build-time fallback; runtime config.js overrides in Docker) ──
VITE_KEYCLOAK_URL=http://192.168.1.36:8080
VITE_KEYCLOAK_REALM=pam
VITE_KEYCLOAK_CLIENT_ID=pam-app
VITE_API_BASE_URL=http://192.168.1.36:3000
