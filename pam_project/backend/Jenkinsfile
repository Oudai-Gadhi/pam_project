pipeline {
    agent any

    environment {
        IMAGE_NAME = "oudaii/pam-backend"
        IMAGE_TAG  = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
        REGISTRY   = credentials('dockerhub-creds')
        BACKEND_DIR = "pam_project/backend"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''
                    echo "Repo root contents:"
                    ls -la
                    echo
                    echo "Backend dir contents:"
                    ls -la pam_project/backend/
                '''
            }
        }

        stage('Ruff (blockers)') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$PWD/pam_project/backend:/app" -w /app \
                      python:3.11-slim \
                      sh -c "pip install -q ruff==0.6.9 && ruff check . --select F,E9"
                '''
            }
        }

        stage('Ruff (warnings)') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$PWD/pam_project/backend:/app" -w /app \
                      python:3.11-slim \
                      sh -c "pip install -q ruff==0.6.9 && ruff check . --output-format=github || true"
                '''
            }
        }

        stage('Build image') {
            steps {
                sh '''
                    cd pam_project/backend
                    docker build \
                      -t "${IMAGE_NAME}:${IMAGE_TAG}" \
                      -t "${IMAGE_NAME}:latest" \
                      .
                '''
            }
        }

        stage('Trivy scan') {
            steps {
                sh '''
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy:latest image \
                      --severity CRITICAL \
                      --ignore-unfixed \
                      --exit-code 1 \
                      "${IMAGE_NAME}:${IMAGE_TAG}"
                '''
            }
        }

        stage('Push') {
            steps {
                sh '''
                    echo "$REGISTRY_PSW" | docker login -u "$REGISTRY_USR" --password-stdin
                    docker push "${IMAGE_NAME}:${IMAGE_TAG}"
                    docker push "${IMAGE_NAME}:latest"
                    docker logout
                '''
            }
        }
    }

    post {
        success { echo "✅ ${IMAGE_NAME}:${IMAGE_TAG} pushed" }
        failure { echo "❌ Failed at ${env.STAGE_NAME}" }
        always {
            sh '''
                docker rmi "${IMAGE_NAME}:${IMAGE_TAG}" "${IMAGE_NAME}:latest" 2>/dev/null || true
                docker logout 2>/dev/null || true
            '''
        }
    }
}
